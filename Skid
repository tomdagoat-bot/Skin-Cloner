const function BC(Info,Character)
	const BodyColors = IsA(Info.BodyColors,"Instance") and Info.BodyColors:Clone() or Instance.new("BodyColors")

	if not IsA(Info.BodyColors,"Instance") then
		for _, Limb in pairs(Tables.Desc_Limbs) do
			const Color = Info.BodyColors[Limb]

			if Color then
				BodyColors[`{Limb}Color3`] = Color
			end
		end
	end

	BodyColors.Parent = Character
end

const function C(Info,Character)
	for Clothing, AssetID in pairs(Info.Cloth) do
		if not AssetID or AssetID == 0 then
			continue
		end

		const Obj = Load(AssetID)

		if Obj then
			Obj.Name = Clothing
			Obj.Parent = Character
		end
	end
end

const function Clear_Mesh(Character)
	for _, Obj in pairs(Character:GetChildren()) do
		if Obj:IsA("CharacterMesh") then
			Obj:Destroy()
		end
	end
end

const function M(Info,Character,Is_R15) -- making ts was the hardest thing ever
	Info.ID = tonumber(
		tostring(Info.ID):match("bundles/(%d+)")
	) or tonumber(Info.ID)
	
	const Bundle_Into = AssetService:GetBundleDetailsAsync(Info.ID)
	const Bundle_Name = Bundle_Into.Name
	
	for _, Limb_Name in ipairs(Info.Limbs) do	
		local AssetID 
		
		for _, Asset in ipairs(Bundle_Into.Items) do
			if Asset.Name:lower():find(Limb_Name:lower()) then
				AssetID = Asset.Id
				break
			end
		end
		
		if AssetID then
			if not Is_R15 then
				const Dynamic_Head = Load(AssetID)

				if Dynamic_Head:IsA("Folder") then
					const Success, Contents = pcall(function()
						return Decode_File(game:HttpGet(`https://assetdelivery.roblox.com/v1/asset/?id={AssetID}`))
					end)
				
					if not Success then
						warn(`Failed To Load Bundle Limb: {Limb_Name}, ID: {AssetID}`)
						continue
					end
				
					const Mesh = Instance.new("CharacterMesh")
				
					for index, value in Contents do
						Mesh[index] = value
					end
				
					Mesh.Parent = Character
					Dynamic_Head:Destroy()
				else
					Dynamic_Head.Parent = Character:FindFirstChild(Limb_Name)	
				end
			else
				const ArtistIntent = Load(AssetID)
				
				if not ArtistIntent then
					warn(`Failed To Load Bundle Limb: {Limb_Name}, ID: {AssetID}`)
					continue
				end
				
				for _, Part in pairs(ArtistIntent:GetChildren()) do
					const Limb = Character:FindFirstChild(Part.Name)
					
					if Limb and Part:IsA("MeshPart") and Limb:IsA("MeshPart") then
						Limb.Size = Part.Size
						Limb.MeshId = Part.MeshId
						Limb.TextureID = Part.TextureID
						Limb.Transparency = Part.Transparency
					end
				end
			end
		end
	end
end
const function ACC(Info,Character)
	for _, AssetID in pairs(Info.Accessories) do
		if AssetID and AssetID ~= 0 then
			const Accessory = Load(AssetID)

			Accessory_Fix(Accessory,Character)
		end
	end
end

const function H(Info,Character)
	for _, Limb in pairs(Info.Hide) do
		const Part = Character:FindFirstChild(Limb)

		if Part then
			Part.Transparency = 1
			
			const Conn = Tables.Connections[`{Character.Name}_{Limb}`]

			if Conn then
				Conn:Disconnect()
			end

			Tables.Connections[`{Character.Name}_{Limb}`] = Part:GetPropertyChangedSignal("Transparency"):Connect(function()
				if Part.Transparency >= 1 then return end
				Part.Transparency = 1
			end)
		end
	end
end

