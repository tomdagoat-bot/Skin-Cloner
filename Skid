function Accessory_Fix(Accessory,Character)
	if not Accessory then
		warn("An Unknown Invalid Accessory Was Attempted To Get Fixed")
		return
	end

	if not Accessory:IsA("Accessory") then
		Accessory.Parent = Character
		return
	end

	const Old = Accessory 

	Accessory = Old:Clone()
	Old:Destroy()

	const Handle = Accessory:FindFirstChild("Handle")

	if not Handle or not Handle:IsA("BasePart") then
		Accessory:Destroy()
		return
	end

	const Rigid = Handle:FindFirstChildOfClass("RigidConstraint")

	if Rigid then
		Rigid:Destroy()
	end

	Handle.CanCollide = false
	Handle.Massless = true

	const Acc_Attachment = Handle:FindFirstChildOfClass("Attachment")

	if not Acc_Attachment then
		Accessory:Destroy()
		return
	end

	const Char_Attachment = Character:FindFirstChild(Acc_Attachment.Name,true)

	if not Char_Attachment or not Char_Attachment:IsA("Attachment") then
		Accessory:Destroy()
		return
	end

	Accessory.Parent = Character

	Handle.CFrame = Char_Attachment.WorldCFrame * Acc_Attachment.CFrame:Inverse()

	const Weld = Instance.new("Weld")

	Weld.Name = "AccessoryWeld"
	Weld.Part0 = Char_Attachment.Parent
	Weld.Part1 = Handle
	Weld.C0 = Char_Attachment.CFrame
	Weld.C1 = Acc_Attachment.CFrame
	Weld.Parent = Handle
end

function Clone_Skin(Skin,Character,Is_R15)
	Skin = Skin:Clone()
	
	for _, Obj in pairs(Skin:GetDescendants()) do
		if Obj.Name == "HumanoidRootPart" then continue end

		if table.find(Tables.Appearance,Obj.ClassName) then
			Accessory_Fix(Obj,Character)
		elseif Obj:IsA("MeshPart") and Is_R15 then
			const Limb = Character:FindFirstChild(Obj.Name)

			if Limb and Limb:IsA("MeshPart") then
				Limb.Size = Obj.Size
				Limb.MeshId = Obj.MeshId
				Limb.TextureID = Obj.TextureID
				Limb.Transparency = Obj.Transparency
			end
		end
	end

	const Avatar_Head = Skin:FindFirstChild("Head")

	if not Avatar_Head then
		Skin:Destroy()
		return
	end

	const face = Avatar_Head:FindFirstChild("face")
	const Mesh_face = Avatar_Head:FindFirstChildOfClass("SpecialMesh")

	const Head = Character:FindFirstChild("Head")
	
	if Head then
		if face then
			face.Parent = Head
		end
		
		if Mesh_face then
			const Old_ = Head:FindFirstChildOfClass("SpecialMesh")
			
			if Old_ then
				Old_:Destroy()
			end
			
			Mesh_face.Parent = Head
		end
	end

	Skin:Destroy()
end

const function Clone_Player(UserID,Character,RigType)
	const Avatar = Players:CreateHumanoidModelFromUserIdAsync(UserID,RigType)

	if not Avatar then
		error(`Roblox Failed To Load The Avatar Of UserID: {UserID}\nMake Sure This User Exists`)
	end
	
	Clone_Skin(Avatar,Character,RigType == R15)
	
	Avatar:Destroy()
end

export type Skin_Info = number | Model | {[string] : boolean | number | string | {Color3 | number | string}}

const function Limbs_Array(Array,Is_R15)
	const Full = Is_R15 and Tables.R15_Limbs or Tables.Limbs

	if not Array then return end

	if Array == "All" then return table.clone(Full) end

	const Result = table.clone(Array)

	if table.find(Result,"Exclude") then
		const Excluded = table.clone(Result)
		table.clear(Result)

		for _, Limb in ipairs(Full) do
			if not table.find(Excluded, Limb) then
				table.insert(Result, Limb)
			end
		end
	end

	return Result
end

function Main(Character,Info : Skin_Info)
	if not Character then
		Character = LocalPlayer.Character
	end
	
	const RigType = Character:FindFirstChildOfClass("Humanoid").RigType
	
	const Is_Custom = IsA(Info,"table")
	const Is_R15 = RigType == R15 
	
	if IsA(Info,"number") then
		Info = {UserId = Info,Keep = false}
	elseif IsA(Info,"Instance") then
		if not Info:IsA("Model") then return end
		
		Info = {Skin = Info,Keep = false}
	end
	
	if Info.Skin and Info.UserId then
		error("use either a userid or a model you idiot",2)
	end
	
	if not Info.Keep then
		Clear_Look(Character,Is_R15)
	end
	
	if Info.UserId then
		Clone_Player(Info.UserId,Character,RigType)
	elseif Info.Skin then
		Clone_Skin(Info.Skin, Character, Is_R15)
	end

	if Is_Custom then
		if Info.Accessories then
			ACC(Info,Character)
		end
		
		if Info.Cloth then
			C(Info,Character)
		end
		
		if Info.Hide then
			Info.Hide = Limbs_Array(Info.Hide,Is_R15)
			H(Info, Character)
		end

		const function Bundle(B)
			B.Limbs = Limbs_Array(B.Limbs,Is_R15)
			M(B, Character, Is_R15)
		end

		if Info.Bundle then
			if not Info.Keep and not Info.Keep_Bundle then
        Clear_Mesh(Character)
      end

			if not Info.Bundle.ID then
				for _, B in ipairs(Info.Bundle) do
					Bundle(B)
				end 
			else
				Bundle(Info.Bundle)
			end
		end
		
		if Info.BodyColors then
			BC(Info,Character)
		end
	end
end

return Main
