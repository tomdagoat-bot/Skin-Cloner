--[[ AVATAR COPIER BY GERP ]]--

--[[
type Limbs = {string} | "All" | typeof({"Exclude_",string})

type Bundle_Info = {
    ID: number | string,
    Limbs: Limbs,
}

type Custom_Skin = {
    BodyColors: {
        Head: Color3,
        Torso: Color3,
        LeftArm: Color3,
        RightArm: Color3,
        LeftLeg: Color3,
        RightLeg: Color3,
    } | BodyColors?,

    Accessories: {number | Accessory},

    Cloth: {
        Shirt: number,
        Pants: number,
        GraphicShirt: number,
    }?,

    Face: number | Decal?,

    Head: {
        MeshId: number | string,
        TextureID: number | string,
    } | MeshPart | Part | number?,

    Bundle: Bundle_Info | {Bundle_Info},

    Hide: Limbs,

    Keep: boolean,
    Keep_Bundle: boolean,
}

const Character = "PATH/TO/A/CHARACTER" -- if nil -> LocalPlayer.Character
const Info: Custom_Skin | number | Model = 1 

loadstring(game:HttpGet("REPO"))(Character,Info)

]]--

local Players = game:GetService("Players")
local AssetService = game:GetService("AssetService")

local LocalPlayer = Players.LocalPlayer
local R15 = Enum.HumanoidRigType.R15
local BodyPart = Enum.BodyPart

local Tables = {
    Appearance = { Accessory = true, Shirt = true, Pants = true, ShirtGraphic = true, BodyColors = true, CharacterMesh = true },
    R6Limbs = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" },
    R15Limbs = {
        "Head", "UpperTorso", "LowerTorso",
        "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightUpperArm", "RightLowerArm", "RightHand",
        "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightUpperLeg", "RightLowerLeg", "RightFoot",
    },
    MeshLimbs = { BodyPart.Head, BodyPart.Torso, BodyPart.LeftArm, BodyPart.RightArm, BodyPart.LeftLeg, BodyPart.RightLeg },
    Connections = {},
}

local function IsA(value, typeName)
    return typeof(value) == typeName
end

local function IsInstance(value, className)
    return typeof(value) == "Instance" and (not className or value:IsA(className))
end

local function NormalizeAssetId(value)
    if value == nil or value == 0 or value == "0" or value == "" then
        return nil
    end

    if typeof(value) == "number" then
        if value <= 0 then return nil end
        return "rbxassetid://" .. tostring(math.floor(value))
    end

    if typeof(value) ~= "string" then
        return nil
    end

    local digits = value:match("[?&]id=(%d+)") or value:match("/bundles/(%d+)") or value:match("rbxassetid://(%d+)") or value:match("^(%d+)$")
    if digits then
        return "rbxassetid://" .. digits
    end

    return value
end

local function GetNumericId(value)
    if typeof(value) == "number" then
        return value > 0 and math.floor(value) or nil
    end
    if typeof(value) ~= "string" then return nil end
    return tonumber(value:match("/bundles/(%d+)") or value:match("[?&]id=(%d+)") or value:match("^(%d+)$"))
end

local function Load(assetId)
    local normalized = NormalizeAssetId(assetId)
    if not normalized or type(game.GetObjects) ~= "function" then
        return nil
    end

    local ok, objects = pcall(function()
        return game:GetObjects(normalized)
    end)
    if not ok or typeof(objects) ~= "table" or not objects[1] then
        warn("[Avatar Copier] Failed to load asset:", tostring(assetId), ok and "No objects returned" or tostring(objects))
        return nil
    end

    return objects[1]
end

-- Reads the legacy binary serialization used by some R6 bundle CharacterMesh assets.
local function DecodeFile(data)
    if typeof(data) ~= "string" or #data < 8 then
        return nil, "Asset data is empty or invalid"
    end

    local function FindProperty(name, expectedType)
        local classStart = data:find("CharacterMesh", 1, true)
        if not classStart then error("CharacterMesh class marker not found") end

        local searchFrom = classStart + #"CharacterMesh"
        while true do
            local pos = data:find(name, searchFrom, true)
            if not pos then error("Property not found: " .. name) end
            local typePosition = pos + #name
            if typePosition <= #data and string.byte(data, typePosition) == expectedType then
                return typePosition
            end
            searchFrom = pos + 1
        end
    end

    local function ReadUInt32BE(position)
        if position < 1 or position + 3 > #data then error("Unexpected end of asset data") end
        local a, b, c, d = string.byte(data, position, position + 3)
        return ((a * 256 + b) * 256 + c) * 256 + d
    end

    local function ReadContentId(name)
        local marker = FindProperty(name, 0x1B)
        -- The content ID is stored as a 32-bit value after the property marker and metadata.
        local encoded = ReadUInt32BE(marker + 5)
        return math.floor(encoded / 2)
    end

    local ok, result = pcall(function()
        local bodyPartValue = ReadUInt32BE(FindProperty("BodyPart", 0x12) + 1) + 1
        local meshId = ReadContentId("MeshId")
        local baseTextureId = ReadContentId("BaseTextureId")
        local overlayTextureId = ReadContentId("OverlayTextureId")
        local bodyPart = Tables.MeshLimbs[bodyPartValue]

        if not bodyPart then error("Unknown BodyPart enum value: " .. tostring(bodyPartValue)) end
        if meshId <= 0 then error("Invalid MeshId") end

        return {
            MeshId = meshId,
            BaseTextureId = baseTextureId,
            OverlayTextureId = overlayTextureId,
            BodyPart = bodyPart,
        }
    end)

    if not ok then
        return nil, tostring(result)
    end
    return result
end

local function GetRigType(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.RigType or Enum.HumanoidRigType.R6
end

local function GetLimbs(isR15)
    return isR15 and Tables.R15Limbs or Tables.R6Limbs
end

local function GetCharacterConnections(character)
    local connections = Tables.Connections[character]
    if not connections then
        connections = {}
        Tables.Connections[character] = connections
    end
    return connections
end

local function DisconnectHiddenConnection(character, limbName)
    local connections = GetCharacterConnections(character)
    local connection = connections[limbName]
    if connection then
        connection:Disconnect()
        connections[limbName] = nil
    end
end

local function ClearLook(character, isR15)
    for _, object in ipairs(character:GetChildren()) do
        if Tables.Appearance[object.ClassName] then
            object:Destroy()
        end
    end

    for _, limbName in ipairs(GetLimbs(isR15)) do
        local limb = character:FindFirstChild(limbName)
        if limb and limb:IsA("BasePart") then
            DisconnectHiddenConnection(character, limbName)
            limb.Transparency = 0
            if limb:IsA("MeshPart") then
                limb.LocalTransparencyModifier = 0
            end
        end
    end

    local head = character:FindFirstChild("Head")
    if head then
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("Decal") and child.Name:lower() == "face" then
                child:Destroy()
            end
        end
    end
end

local function AccessoryFix(object, character)
    if not object then
        warn("[Avatar Copier] Cannot attach a missing asset")
        return
    end

    if not object:IsA("Accessory") then
        object.Parent = character
        return object
    end

    local accessory = object
    local handle = accessory:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        accessory:Destroy()
        return nil
    end

    local rigid = handle:FindFirstChildOfClass("RigidConstraint")
    if rigid then rigid:Destroy() end

    handle.CanCollide = false
    handle.Massless = true

    local accessoryAttachment = handle:FindFirstChildWhichIsA("Attachment")
    if not accessoryAttachment then
        accessory:Destroy()
        return nil
    end

    local characterAttachment = character:FindFirstChild(accessoryAttachment.Name, true)
    if not characterAttachment or not characterAttachment:IsA("Attachment") or not characterAttachment.Parent:IsA("BasePart") then
        accessory:Destroy()
        return nil
    end

    accessory.Parent = character
    handle.CFrame = characterAttachment.WorldCFrame * accessoryAttachment.CFrame:Inverse()

    local oldWeld = handle:FindFirstChild("AccessoryWeld")
    if oldWeld then oldWeld:Destroy() end

    local weld = Instance.new("Weld")
    weld.Name = "AccessoryWeld"
    weld.Part0 = characterAttachment.Parent
    weld.Part1 = handle
    weld.C0 = characterAttachment.CFrame
    weld.C1 = accessoryAttachment.CFrame
    weld.Parent = handle
    return accessory
end

local function CopyMeshPartProperties(source, target, copySize)
    if not source or not target or not source:IsA("MeshPart") or not target:IsA("MeshPart") then return end
    if copySize then target.Size = source.Size end
    target.MeshId = source.MeshId
    target.TextureID = source.TextureID
    target.Transparency = source.Transparency
end

local function CopyFaceDecal(sourceHead, targetHead)
    if not sourceHead or not targetHead then return end
    local sourceFace
    for _, child in ipairs(sourceHead:GetChildren()) do
        if child:IsA("Decal") and (child.Name:lower() == "face" or not sourceFace) then
            sourceFace = child
            if child.Name:lower() == "face" then break end
        end
    end
    if not sourceFace then return end

    for _, child in ipairs(targetHead:GetChildren()) do
        if child:IsA("Decal") and (child.Name:lower() == "face" or child.Face == sourceFace.Face) then
            child:Destroy()
        end
    end

    local face = sourceFace:Clone()
    face.Name = "face"
    face.Parent = targetHead
end

local function CopyHeadMesh(sourceHead, targetHead, targetIsR15)
    if not sourceHead or not targetHead then return end

    CopyFaceDecal(sourceHead, targetHead)

    if targetIsR15 then
        if sourceHead:IsA("MeshPart") and targetHead:IsA("MeshPart") then
            CopyMeshPartProperties(sourceHead, targetHead, false)
        elseif sourceHead:IsA("Part") then
            local sourceMesh = sourceHead:FindFirstChildOfClass("SpecialMesh")
            if sourceMesh and targetHead:IsA("MeshPart") then
                -- A SpecialMesh cannot be assigned to a MeshPart; preserve the target mesh instead.
                warn("[Avatar Copier] Source head uses SpecialMesh but target R15 head is a MeshPart; only the face decal was copied")
            end
        end
        return
    end

    if sourceHead:IsA("MeshPart") then
        local sourceMeshId = sourceHead.MeshId
        local sourceTextureId = sourceHead.TextureID
        local targetMesh = targetHead:FindFirstChildOfClass("SpecialMesh")
        if not targetMesh then
            targetMesh = Instance.new("SpecialMesh")
            targetMesh.Name = "Mesh"
            targetMesh.MeshType = Enum.MeshType.FileMesh
            targetMesh.Parent = targetHead
        end
        targetMesh.MeshType = Enum.MeshType.FileMesh
        targetMesh.MeshId = sourceMeshId
        targetMesh.TextureId = sourceTextureId
    elseif sourceHead:IsA("Part") then
        local sourceMesh = sourceHead:FindFirstChildOfClass("SpecialMesh")
        if sourceMesh then
            local targetMesh = targetHead:FindFirstChildOfClass("SpecialMesh")
            if not targetMesh then
                targetMesh = Instance.new("SpecialMesh")
                targetMesh.Name = sourceMesh.Name
                targetMesh.Parent = targetHead
            end
            targetMesh.MeshType = sourceMesh.MeshType
            targetMesh.MeshId = sourceMesh.MeshId
            targetMesh.TextureId = sourceMesh.TextureId
            targetMesh.Scale = sourceMesh.Scale
            targetMesh.Offset = sourceMesh.Offset
        end
    end
end

local function CopyBodyColors(info, character)
    local colors = info.BodyColors
    if not colors then return end

    local bodyColors
    if IsInstance(colors, "BodyColors") then
        bodyColors = colors:Clone()
    else
        bodyColors = Instance.new("BodyColors")
        local mapping = {
            Head = "HeadColor3", Torso = "TorsoColor3",
            LeftArm = "LeftArmColor3", RightArm = "RightArmColor3",
            LeftLeg = "LeftLegColor3", RightLeg = "RightLegColor3",
        }
        for key, property in pairs(mapping) do
            local color = colors[key]
            if typeof(color) == "Color3" then
                bodyColors[property] = color
            end
        end
    end
    bodyColors.Parent = character
end

local function ApplyClothing(info, character)
    if typeof(info.Cloth) ~= "table" then return end
    for name, assetId in pairs(info.Cloth) do
        local object = Load(assetId)
        if object then
            if object:IsA("Shirt") or object:IsA("Pants") or object:IsA("ShirtGraphic") then
                object.Name = name
                object.Parent = character
            else
                object:Destroy()
                warn("[Avatar Copier] Clothing asset did not load as a clothing instance:", tostring(assetId))
            end
        end
    end
end

local function ApplyAccessories(info, character)
    if typeof(info.Accessories) ~= "table" then return end
    for _, assetId in pairs(info.Accessories) do
        local object = Load(assetId)
        if object then AccessoryFix(object, character) end
    end
end

local function ApplyHiddenLimbs(info, character, isR15)
    if typeof(info.Hide) ~= "table" then return end
    local limbs = info.Hide
    if limbs == "All" then limbs = GetLimbs(isR15) end

    for _, limbName in ipairs(limbs) do
        local part = character:FindFirstChild(limbName)
        if part and part:IsA("BasePart") then
            part.Transparency = 1
            local connections = GetCharacterConnections(character)
            if connections[limbName] then connections[limbName]:Disconnect() end
            connections[limbName] = part:GetPropertyChangedSignal("Transparency"):Connect(function()
                if part.Parent and part.Transparency < 1 then part.Transparency = 1 end
            end)
        end
    end
end

local function ClearCharacterMeshes(character)
    for _, object in ipairs(character:GetChildren()) do
        if object:IsA("CharacterMesh") then object:Destroy() end
    end
end

local function ApplyBundle(info, character, isR15)
    local bundleId = GetNumericId(info.ID)
    if not bundleId then
        warn("[Avatar Copier] Invalid bundle ID:", tostring(info.ID))
        return
    end

    local ok, bundle = pcall(function()
        return AssetService:GetBundleDetailsAsync(bundleId)
    end)
    if not ok or not bundle or typeof(bundle.Items) ~= "table" then
        warn("[Avatar Copier] Failed to get bundle details:", tostring(info.ID), tostring(bundle))
        return
    end

    local requestedLimbs = info.Limbs
    if requestedLimbs == nil or requestedLimbs == "All" then requestedLimbs = GetLimbs(isR15) end
    if typeof(requestedLimbs) ~= "table" then return end

    for _, limbName in ipairs(requestedLimbs) do
        local assetId
        for _, asset in ipairs(bundle.Items) do
            local assetName = tostring(asset.Name or "")
            if assetName:lower():find(tostring(limbName):lower(), 1, true) then
                assetId = asset.Id
                break
            end
        end
        if not assetId then continue end

        local asset = Load(assetId)
        if not asset then continue end

        if isR15 then
            local sourceParts = {}
            if asset:IsA("BasePart") then
                sourceParts[asset.Name] = asset
            else
                for _, descendant in ipairs(asset:GetDescendants()) do
                    if descendant:IsA("MeshPart") then sourceParts[descendant.Name] = descendant end
                end
                for _, child in ipairs(asset:GetChildren()) do
                    if child:IsA("MeshPart") then sourceParts[child.Name] = child end
                end
            end
            for partName, sourcePart in pairs(sourceParts) do
                local targetPart = character:FindFirstChild(partName)
                if targetPart and targetPart:IsA("MeshPart") then
                    CopyMeshPartProperties(sourcePart, targetPart, true)
                end
            end
        else
            if asset:IsA("Folder") or asset:IsA("Model") then
                local raw
                local success, result = pcall(function()
                    return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. tostring(assetId))
                end)
                if success then raw = result end
                local decoded, decodeError
                if raw then
                    decoded, decodeError = DecodeFile(raw)
                else
                    decodeError = "Could not retrieve raw asset data"
                end

                if decoded then
                    local mesh = Instance.new("CharacterMesh")
                    for property, value in pairs(decoded) do
                        local successSet, setError = pcall(function() mesh[property] = value end)
                        if not successSet then warn("[Avatar Copier] Could not set CharacterMesh property", property, setError) end
                    end
                    mesh.Parent = character
                else
                    warn("[Avatar Copier] Could not decode R6 bundle limb", tostring(limbName), tostring(decodeError))
                end
            else
                local target = character:FindFirstChild(limbName)
                if target and asset:IsA("BasePart") then
                    local mesh = asset:FindFirstChildOfClass("SpecialMesh")
                    if mesh and target:IsA("Part") then
                        local old = target:FindFirstChildOfClass("SpecialMesh")
                        if old then old:Destroy() end
                        mesh:Clone().Parent = target
                    end
                end
            end
        end
        asset:Destroy()
    end
end

local function ApplyHeadOverrides(info, character, isR15)
    local head = character:FindFirstChild("Head")
    if not head then return end

    -- Custom skin options:
    -- Face = decal asset ID, or a Decal instance.
    -- Head = a MeshPart/Part, an asset ID to Load(), or { MeshId = ..., TextureID/TextureId = ... }.
    local faceValue = info.Face
    if IsInstance(faceValue, "Decal") then
        local oldFace = head:FindFirstChild("face")
        if oldFace then oldFace:Destroy() end
        local face = faceValue:Clone()
        face.Name = "face"
        face.Parent = head
    elseif faceValue then
        local loadedFace = Load(faceValue)
        if loadedFace then
            local decal = loadedFace:IsA("Decal") and loadedFace or loadedFace:FindFirstChildWhichIsA("Decal", true)
            if decal then
                local oldFace = head:FindFirstChild("face")
                if oldFace then oldFace:Destroy() end
                local clone = decal:Clone()
                clone.Name = "face"
                clone.Parent = head
            end
            loadedFace:Destroy()
        end
    end

    local headValue = info.Head or info.HeadProperties
    if IsInstance(headValue, "BasePart") then
        CopyHeadMesh(headValue, head, isR15)
    elseif typeof(headValue) == "number" or typeof(headValue) == "string" then
        local loadedHead = Load(headValue)
        if loadedHead then
            local sourceHead = loadedHead:IsA("BasePart") and loadedHead or loadedHead:FindFirstChild("Head", true)
            if sourceHead and sourceHead:IsA("BasePart") then CopyHeadMesh(sourceHead, head, isR15) end
            loadedHead:Destroy()
        end
    elseif typeof(headValue) == "table" then
        local meshId = headValue.MeshId or headValue.MeshID
        local textureId = headValue.TextureID or headValue.TextureId or headValue.Texture
        if isR15 and head:IsA("MeshPart") then
            if meshId then head.MeshId = NormalizeAssetId(meshId) or head.MeshId end
            if textureId then head.TextureID = NormalizeAssetId(textureId) or head.TextureID end
        elseif not isR15 and head:IsA("BasePart") then
            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if not mesh then mesh = Instance.new("SpecialMesh"); mesh.MeshType = Enum.MeshType.FileMesh; mesh.Parent = head end
            if meshId then mesh.MeshId = NormalizeAssetId(meshId) or mesh.MeshId end
            if textureId then mesh.TextureId = NormalizeAssetId(textureId) or mesh.TextureId end
        end
    end
end

local function CloneSkin(sourceModel, character, targetIsR15)
    if not sourceModel or not sourceModel:IsA("Model") then return false end
    local source = sourceModel:Clone()
    local sourceHead = source:FindFirstChild("Head")

    -- Copy avatar assets before destroying the temporary source model.
    for _, object in ipairs(source:GetDescendants()) do
        if object.Name == "HumanoidRootPart" then continue end
        if Tables.Appearance[object.ClassName] then
            AccessoryFix(object:Clone(), character)
        elseif targetIsR15 and object:IsA("MeshPart") then
            local target = character:FindFirstChild(object.Name)
            if target and target:IsA("MeshPart") then CopyMeshPartProperties(object, target, true) end
        end
    end

    ApplyHeadOverrides({
        Face = sourceHead and sourceHead:FindFirstChildWhichIsA("Decal"),
        Head = sourceHead,
    }, character, targetIsR15)

    source:Destroy()
    return true
end

local function ClonePlayer(userId, character, rigType)
    local id = tonumber(userId)
    if not id or id <= 0 then
        warn("[Avatar Copier] Invalid UserId:", tostring(userId))
        return false
    end

    local ok, avatar = pcall(function()
        return Players:CreateHumanoidModelFromUserIdAsync(id, rigType)
    end)
    if not ok or not avatar then
        warn("[Avatar Copier] Failed to load avatar for UserId:", tostring(userId), tostring(avatar))
        return false
    end

    CloneSkin(avatar, character, rigType == R15)
    avatar:Destroy()
    return true
end

local function LimbsArray(array, isR15)
    local full = GetLimbs(isR15)
    if not array then return nil end
    if array == "All" then return table.clone(full) end
    if typeof(array) ~= "table" then return nil end

    local excluded = table.find(array, "Exclude_") ~= nil
    if not excluded then return table.clone(array) end

    local result = {}
    for _, limb in ipairs(full) do
        if not table.find(array, limb) then table.insert(result, limb) end
    end
    return result
end

export type Skin_Info = number | Model | { [string]: any }

local function Main(character, info)
    character = character or (LocalPlayer and LocalPlayer.Character)
    if not character or not character:IsA("Model") then
        warn("[Avatar Copier] No valid target character")
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        warn("[Avatar Copier] Target character has no Humanoid")
        return
    end

    if typeof(info) == "number" then
        info = { UserId = info, Keep = false }
    elseif IsInstance(info, "Model") then
        info = { Skin = info, Keep = false }
    elseif typeof(info) ~= "table" then
        warn("[Avatar Copier] Info must be a UserId, Model, or table")
        return
    end

    if info.Skin and info.UserId then
        error("Use either Skin or UserId, not both", 2)
    end

    local isR15 = humanoid.RigType == R15
    if not info.Keep then ClearLook(character, isR15) end

    if info.UserId then
        ClonePlayer(info.UserId, character, humanoid.RigType)
    elseif info.Skin then
        if IsInstance(info.Skin, "Model") then
            CloneSkin(info.Skin, character, isR15)
        else
            warn("[Avatar Copier] Skin must be a Model")
        end
    end

    ApplyHeadOverrides(info, character, isR15)
    ApplyAccessories(info, character)
    ApplyClothing(info, character)
    ApplyHiddenLimbs({ Hide = LimbsArray(info.Hide, isR15) }, character, isR15)

    if info.Bundle then
        if not info.Keep and not info.Keep_Bundle then ClearCharacterMeshes(character) end
        local function apply(bundleInfo)
            if typeof(bundleInfo) == "table" then
                bundleInfo.Limbs = LimbsArray(bundleInfo.Limbs, isR15)
                ApplyBundle(bundleInfo, character, isR15)
            end
        end
        if info.Bundle.ID then
            apply(info.Bundle)
        elseif typeof(info.Bundle) == "table" then
            for _, bundleInfo in ipairs(info.Bundle) do apply(bundleInfo) end
        end
    end

    CopyBodyColors(info, character)
end

return Main
