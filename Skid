const Body_Part = Enum.BodyPart

const Tables = {
	Appearance = {"Accessory", "Shirt", "Pants", "ShirtGraphic", "BodyColors", "CharacterMesh"},
	Limbs = {"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"},
	R15_Limbs = {
		"LeftFoot","LeftHand","LeftLowerArm","LeftLowerLeg","LeftUpperArm","LeftUpperLeg",
		"RightFoot","RightHand","RightLowerArm","RightLowerLeg","RightUpperArm","RightUpperLeg",
		"UpperTorso","LowerTorso",
		"Head"
	},
	Desc_Limbs = {"Head","Torso","LeftArm","RightArm","LeftLeg","RightLeg"},
	Cloth = {"Shirt","Pants","GraphicTShirt"},
	Mesh_Limbs = {
		[0] = Body_Part.Head,
		[1] = Body_Part.Torso,
		[2] = Body_Part.LeftArm,
		[3] = Body_Part.RightArm,
		[4] = Body_Part.LeftLeg,
		[5] = Body_Part.RightLeg
	},
	Connections = {},
}

const function Decode_File(Data) -- wtf
	const function Find_Property(Name, PropertyType)
		const Position =  Data:find(Name, Data:find("CharacterMesh", 1, true), true) + #Name

		assert(string.byte(Data, Position) == PropertyType,`Unexpected Encoding For {Name}`)

		return Position
	end

	const function ReadUInt32BE(Position)
		const A, B, C, D = string.byte(Data,Position,Position + 3)

		assert(D, "Unexpected End Of File")

		return ((A * 256 + B) * 256 + C) * 256 + D
	end

	const function ReadContentId(Name)
		return math.floor(ReadUInt32BE(Find_Property(Name, 0x1B) + 5) / 2)
	end

	const BodyPart_Value = ReadUInt32BE(Find_Property("BodyPart", 0x12) + 1)

	local MeshId = ReadContentId("MeshId")
	local BaseTextureId = ReadContentId("BaseTextureId")
	local OverlayTextureId = ReadContentId("OverlayTextureId")

	assert(Tables.Mesh_Limbs[BodyPart_Value], "Unknown BodyPart Enum Value")
	assert(MeshId > 0, "Invalid Mesh ID")

	return {
		MeshId = MeshId,
		BaseTextureId = BaseTextureId,
		OverlayTextureId = OverlayTextureId,
		BodyPart = Tables.Mesh_Limbs[BodyPart_Value],
	}
end

const R15 = Enum.HumanoidRigType.R15

const function IsA(Object,Type) : boolean
	return typeof(Object) == Type
end

const function ID(Id)
	return IsA(Id,"number") and `rbxassetid://{tostring(Id)}` or Id
end

const function Load(AssetID)
	if not AssetID or AssetID == 0 then
		return
	end

	const Objects = game:GetObjects(ID(AssetID))

	if not Objects or #Objects < 1 then
		warn(`Failed To Load Object: {AssetID}`)
		return
	end

	return Objects[1]
end

const function Clear_Look(Character,Is_R15)
	for _, Obj in pairs(Character:GetChildren()) do
		if 	table.find(Tables.Appearance,Obj.ClassName) then
			Obj:Destroy()
		end
	end

	for _, Limb in pairs(Is_R15 and Tables.R15_Limbs or Tables.Limbs) do
		local Limb = Character:FindFirstChild(Limb)

		if Limb then
			const Conn = Tables.Connections[`{Character.Name}_{Limb}`]

			if Conn then
				Conn:Disconnect()
				Tables.Connections[`{Character.Name}_{Limb}`] = nil
			end
			
			Limb.Transparency = 0
		end
	end

	const Head : Part = Character:FindFirstChild("Head")

	if Head then
		const face = Head:FindFirstChildOfClass("Decal")

		if face then
			face:Destroy()
		end
	end
end

